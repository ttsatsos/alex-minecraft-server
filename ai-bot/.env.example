MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.11

# For this server's current online-mode=true setup, use microsoft auth
# and a real paid Java/Microsoft account for the bot.
BOT_USERNAME=bot-account@example.com
BOT_AUTH=microsoft
BOT_DISPLAY_NAME=Companion
BOT_PROFILES_DIR=./profiles

# Optional: set to a player name to let that player control follow/stop commands.
BOT_OWNER=DragonXander
BOT_CHAT_PREFIX=!bot
BOT_FOLLOW_RANGE=3

# LLM configuration. This bot uses an OpenAI-compatible chat endpoint.
# Point LLM_BASE_URL at OpenAI or any compatible provider.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=160

# Keep the character focused, brief, and in-world.
LLM_SYSTEM_PROMPT=You are a helpful Minecraft companion named Companion. Speak briefly, casually, and like an in-world player. Avoid mentioning APIs, tokens, or being an AI unless directly asked.
